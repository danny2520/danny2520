# Connect a dedicated PostgreSQL development database (e.g. Neon).
# DO NOT paste real passwords or connection strings into GitHub.
DATABASE_URL=postgresql://user:password@localhost:5432/zyvra_dev
# Random secret of at least 32 characters, independent from database credentials.
AUTH_SECRET=replace-with-strong-random-secret-at-least-32-characters

# Created automatically when Vercel Blob is connected to the project.
# For local development, fetch via Vercel CLI; never commit the real token.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
